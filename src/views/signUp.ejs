<%- include('partials/header', { title: 'Crear cuenta' }) %>
<section class="entry">
    <div class="lockup">
        <h1>pase</h1>
        <p>Crea tu cuenta y recibe tu pase de acceso.</p>
    </div>

    <article class="pass">
        <div class="pass-head">
            <h2>Crear cuenta</h2>
            <p>Tus datos para armar tu pase.</p>
        </div>
        <div class="pass-cut"></div>
        <div class="pass-body">
            <form id="signup-form" novalidate>
                <div id="msg" class="msg" role="alert"></div>

                <div class="field-row">
                    <div class="field">
                        <label for="name">Nombre</label>
                        <input class="browser-default" type="text" id="name" name="name" autocomplete="given-name" required>
                    </div>
                    <div class="field">
                        <label for="lastName">Apellido</label>
                        <input class="browser-default" type="text" id="lastName" name="lastName" autocomplete="family-name" required>
                    </div>
                </div>

                <div class="field-row">
                    <div class="field">
                        <label for="phoneNumber">Teléfono</label>
                        <input class="browser-default" type="tel" id="phoneNumber" name="phoneNumber" autocomplete="tel" required>
                    </div>
                    <div class="field">
                        <label for="birthdate">Fecha de nacimiento</label>
                        <input class="browser-default" type="date" id="birthdate" name="birthdate" required>
                    </div>
                </div>

                <div class="field">
                    <label for="email">Email</label>
                    <input class="browser-default" type="email" id="email" name="email" autocomplete="email" required>
                </div>

                <div class="field">
                    <label for="password">Contraseña</label>
                    <input class="browser-default" type="password" id="password" name="password" autocomplete="new-password" required>
                    <p class="hint">Mínimo 8 caracteres, con 1 mayúscula, 1 número y 1 símbolo (# $ % & * @).</p>
                </div>

                <button id="submit" class="btn-pase" type="submit">Crear mi pase</button>
            </form>
            <p class="link-line">¿Ya tienes cuenta? <a href="/signIn">Inicia sesión</a></p>
        </div>
    </article>
</section>
<%- include('partials/footer') %>
<script>
    Auth.redirectIfLogged();

    const form = document.getElementById('signup-form');
    const msg = document.getElementById('msg');
    const submit = document.getElementById('submit');
    const PASSWORD_REGEX = /^(?=.*[A-Z])(?=.*\d)(?=.*[#$%&*@]).{8,}$/;

    form.birthdate.max = new Date().toISOString().split('T')[0];

    const showError = (text) => {
        msg.textContent = text;
        msg.classList.add('show');
    };

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        msg.classList.remove('show');

        const data = {
            name: form.name.value.trim(),
            lastName: form.lastName.value.trim(),
            phoneNumber: form.phoneNumber.value.trim(),
            birthdate: form.birthdate.value,
            email: form.email.value.trim(),
            password: form.password.value
        };

        if (Object.values(data).some(v => !v)) {
            showError('Completa todos los campos.');
            return;
        }

        if (!PASSWORD_REGEX.test(data.password)) {
            showError('La contraseña necesita mínimo 8 caracteres, 1 mayúscula, 1 número y 1 símbolo (# $ % & * @).');
            return;
        }

        submit.disabled = true;

        try {
            await Auth.api('/api/auth/signUp', {
                method: 'POST',
                body: JSON.stringify(data)
            });
            Auth.notify('Cuenta creada. Ahora inicia sesión.', true);
            setTimeout(() => { window.location.href = '/signIn'; }, 1200);
        } catch (err) {
            showError(err.message);
            submit.disabled = false;
        }
    });
</script>
</body>
</html>