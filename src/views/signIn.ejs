<%- include('partials/header', { title: 'Iniciar sesión' }) %>
<section class="entry">
    <div class="lockup">
        <h1>pase</h1>
        <p>Entra con tu cuenta y abre tu pase de acceso.</p>
    </div>

    <article class="pass">
        <div class="pass-head">
            <h2>Iniciar sesión</h2>
            <p>Usa el email con el que te registraste.</p>
        </div>
        <div class="pass-cut"></div>
        <div class="pass-body">
            <form id="signin-form" novalidate>
                <div id="msg" class="msg" role="alert"></div>

                <div class="field">
                    <label for="email">Email</label>
                    <input class="browser-default" type="email" id="email" name="email" autocomplete="email" required>
                </div>

                <div class="field">
                    <label for="password">Contraseña</label>
                    <input class="browser-default" type="password" id="password" name="password" autocomplete="current-password" required>
                </div>

                <button id="submit" class="btn-pase" type="submit">Entrar</button>
            </form>
            <p class="link-line">¿No tienes cuenta? <a href="/signUp">Crea tu pase</a></p>
        </div>
    </article>
</section>
<%- include('partials/footer') %>
<script>
    Auth.redirectIfLogged();

    const form = document.getElementById('signin-form');
    const msg = document.getElementById('msg');
    const submit = document.getElementById('submit');

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        msg.classList.remove('show');

        if (!form.email.value.trim() || !form.password.value) {
            msg.textContent = 'Escribe tu email y tu contraseña.';
            msg.classList.add('show');
            return;
        }

        submit.disabled = true;

        try {
            const { token } = await Auth.api('/api/auth/signIn', {
                method: 'POST',
                body: JSON.stringify({
                    email: form.email.value.trim(),
                    password: form.password.value
                })
            });
            Auth.setToken(token);
            window.location.href = Auth.homePath();
        } catch (err) {
            msg.textContent = err.message;
            msg.classList.add('show');
            submit.disabled = false;
        }
    });
</script>
</body>
</html>