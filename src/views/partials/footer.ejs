</main>
<script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
<script src="/js/auth.js"></script>
<script>
    (() => {
        if (!document.body.classList.contains('is-private')) return;

        const timer = document.getElementById('session-timer');
        const logoutBtn = document.getElementById('logout-btn');
        const navAdmin = document.getElementById('nav-admin');

        logoutBtn.addEventListener('click', () => Auth.logout());

        if (Auth.isAdmin()) navAdmin.classList.remove('hide');

        const payload = Auth.getPayload();
        if (!payload) return;

        const render = () => {
            const left = Math.max(0, payload.exp * 1000 - Date.now());
            const minutes = String(Math.floor(left / 60000)).padStart(2, '0');
            const seconds = String(Math.floor((left % 60000) / 1000)).padStart(2, '0');
            timer.textContent = `${minutes}:${seconds}`;
            timer.classList.toggle('low', left < 5 * 60 * 1000);
        };

        render();
        setInterval(render, 1000);
    })();
</script>